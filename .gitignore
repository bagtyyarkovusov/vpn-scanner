# Append to .gitignore; remove any rule ignoring the .agents directory itself.
# Track the relative skill symlink while ignoring other Codex state.
.agents/*
!.agents/skills

# Local agent/tooling state; keep .claude/skills tracked.
.claude/worktrees/
.claude/settings.local.json
.codex/
.DS_Store
*.log
.env
.env.*
!.env.example
!.env.template
